# Copy this file to .env and fill in your values. Never commit .env.

# Ask AI — server-side only
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-haiku-3.5

# Canonical URL (used for OpenRouter HTTP-Referer / sitemap)
PUBLIC_SITE_URL=https://samuel3d.vercel.app

# Spotify (optional — falls back to iTunes previews)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Contact email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=samuelislislegend8@gmail.com
CONTACT_TO=samuelislislegend8@gmail.com

# Guestbook (MongoDB)
MONGODB_URI=
MONGODB_DB=portfolio

# GitHub (optional — raises rate limits)
GITHUB_USER=Samuel-Fx-1
GITHUB_TOKEN=

# Local API port
API_PORT=5001
