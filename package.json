{
  "name": "samuel-fx-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of Izabayo Samuel (Samuel Fx) — React + Parcel + Express",
  "author": "Izabayo Samuel <samuelislislegend8@gmail.com>",
  "scripts": {
    "dev": "concurrently \"npm run dev:parcel\" \"npm run dev:api\"",
    "dev:parcel": "parcel src/index.html rankai.html",
    "dev:api": "node server/index.js",
    "build": "parcel build index.html rankai.html --dist-dir dist",
    "start": "node server/index.js",
    "lint": "eslint src server api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "parcel": "^2.12.0",
    "process": "^0.11.10"
  },
  "alias": {
    "react": "./node_modules/react",
    "react-dom": "./node_modules/react-dom"
  }
}
