
# ------------------------------------------------------------------
# 1. Copy this file to `.env.local`
#      cp .env.local.example .env.local
# 2. Paste your key from https://openrouter.ai/keys
# 3. Restart the dev server
# ------------------------------------------------------------------

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — any model id from https://openrouter.ai/models
# Cheap + great for chat:      openai/gpt-4o-mini
# Free options (rate limited): meta-llama/llama-3.3-70b-instruct:free
#                              google/gemini-2.0-flash-exp:free
#                              deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — sent to OpenRouter as HTTP-Referer / X-Title for rankings
NEXT_PUBLIC_SITE_URL=http://localhost:3000